@startuml
!include _theme.puml
title er-01: The referential in data/*.json (PRD-0001 US-09, US-10, US-14 to US-18)

entity Territory {
  * code : string <<PK>> (CH or canton)
  --
  * name : string
  parliament : string (covered cantons)
  note : string
}

entity Party {
  * id : string <<PK>>
  --
  * territory : string <<FK>>
  * name, abbr, short : string
  * position : string
  * description : string
  url : url or null
  * status : verified | to_confirm | not_found
  * checked_on : date
  * evidence : string
}

entity LeftRight {
  * value : number (0 to 10)
  --
  * scale, dataset : string
  * source : url
  * checked_on : date
  inherited_from : party id
}

entity SourcedFact {
  * kind : founded
  --
  * value : integer
  source : url or null
  checked_on : date or null
}

entity Presidency {
  * names : list of string
  --
  * source : url (party's page)
  * evidence : string
  * checked_on : date
}

entity PreviousUrl {
  * url : url
  --
  * seen_on : date
  * note : string
}

entity StateSite {
  * id : string <<PK>>
  --
  * territory : string <<FK>>
  * name, description : string
  url : url or null
  * status, checked_on, evidence
}

entity Tool {
  * id : string <<PK>>
  --
  * name, description : string
  url : url or null
  * status, checked_on, evidence
}

entity Ballot {
  * date : date
  --
  * label, voting_material : string
  * page, brochure : url
}

entity BallotItem {
  * id : string <<PK>>
  --
  * short, title, question : string
  * yes, no : string
  federal_council : yes | no | null
  * url : url
  * parties : abbr to yes | no | free
}

entity CantonBallot {
  * canton : string <<FK>>
  --
  * items : list of titles
  * url : url
}

entity Parliament <<generated>> {
  * retrieved_on : date
  --
  * request : string (no key)
  * api_docs, terms_page : url
  * attribution, license : string
  * party_mapping : API label to abbr
}

entity ParliamentPerson <<raw>> {
  * id : integer <<PK>>
  --
  * firstName, lastName : string
  council.abbreviation : CN | CE | null
  party.shortName : string | null
  canton.abbreviation : string | null
}

entity FederalCouncilMandate <<raw>> {
  * function.key, function.name : string
  --
  * department.abbreviation : string
  * department.name : string
}

entity CantonalParliaments <<generated>> {
  * retrieved_on : date
  --
  * request : string
  * asset_url : url
  * title, table, sheet : string
  * attribution, license : string
  * columns : list of OFS labels
  * notes : list of string
  * party_mapping : canton to column to party id
}

entity CantonalParliamentRow <<raw>> {
  * label : string (canton name)
  --
  * cells : column label to text
}

entity CantonalGovernment {
  * canton : string <<PK>> <<FK>>
  --
  * body : string
}

entity GovernmentMember {
  * name : string
  --
  * party : party id <<FK>>
  * department : string
  role : string or null
  * source, party_source : url
  * checked_on : date
}

entity BallotSource {
  * title : string
  --
  * url : url
}

Territory ||--o{ Party : territory
Territory ||--o{ StateSite : territory
Party ||--o{ SourcedFact : facts
Party ||--o| Presidency : facts.presidency
Party ||--o| LeftRight : left_right
LeftRight }o..o| Party : inherited_from\n(a CH party)
Party ||--o{ PreviousUrl : previous_urls
StateSite ||--o{ PreviousUrl : previous_urls
Tool ||--o{ PreviousUrl : previous_urls
Ballot ||--|{ BallotItem : items
Ballot ||--o{ CantonBallot : cantons
Territory ||--o| CantonBallot : canton
Ballot ||--o{ BallotSource : sources
BallotItem }o..o{ Party : parties keyed by abbr\n(CH parties only)
Parliament ||--|{ ParliamentPerson : persons
ParliamentPerson ||--o{ FederalCouncilMandate : activeFederalCouncilMandates
Parliament }o..o{ Party : party_mapping to abbr\n(CH parties only)
ParliamentPerson }o..o| Territory : canton
CantonalParliaments ||--|{ CantonalParliamentRow : rows
CantonalParliamentRow }o..|| Territory : label = canton name
CantonalParliaments }o..o{ Party : party_mapping to id\n(parties of the canton)
Territory ||--o| CantonalGovernment : canton
CantonalGovernment ||--|{ GovernmentMember : members
GovernmentMember }o--|| Party : party (of the canton)

@enduml
