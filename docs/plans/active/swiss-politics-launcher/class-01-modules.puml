@startuml
!include _theme.puml
' Dots in the package names are not namespaces.
set separator none
title class-01: Modules of the site and of the tooling (PRD-0001)

package "src/site (bundled into dist/js/site.js)" {
  class "main.ts" as main <<entry>> {
    starts app, ballot, institutions
  }
  class "app.ts" as app {
    +start()
    +scope() : level, canton
    +onRender(listener)
    +cantonName(code), ofCanton(code)
    routing, menu, territory sheet
    parties half-circle and card
    (presidency, federal and cantonal lines)
    aids, state sites
  }
  class "ballot.ts" as ballot {
    +start()
    ballot list, item page
    Comprendre / Comparer / Décider
  }
  class "institutions.ts" as inst {
    +start()
    Federal Council, chambers
    a canton: government, Grand Conseil,
    members in Bern
  }
  class "parliament.ts" as parl {
    +membersOf(), isFederalCouncillor()
    +seatGroups(), partyMembers()
    +mainLabel(), ownMandates()
    pure, no DOM, no data import
  }
  class "cantonal-parliaments.ts" as cparl {
    +cantonRow(), cantonSeats()
    +councilGroups(), othersNote()
    pure, OFS file reading
  }
  class "cantonal-standing.ts" as standing {
    +cantonalStanding()
    +governmentSources(), siteName()
    pure, cantonal card lines
  }
  class "presidency.ts" as pres {
    +presidencyFact(), namesText()
    pure, presidency line
  }
  class "party-colours.ts" as colours {
    +partyColour(abbr)
    palette B2, "Autres"
  }
  class "referential.ts" as ref {
    +federal : Level
    +cantons : Record<code, Canton>
    +tools, ballot, parliament
    +stateSiteUrl(id), toolUrl(id)
  }
  class "links.ts" as links {
    +STATE_SITE_IDS
    +TOOL_IDS, TOOLS_PAGE_IDS
  }
  class "dom.ts" as dom {
    +$(), escapeHtml(), normalize()
    +host(), swissDate()
  }
}

class "src/types.ts" as types {
  interfaces of the referential
  one schema per interface
  +DATA_FILES, PARLIAMENT_FUNCTIONS
}

package "tools (run by Node 26 from .ts)" {
  class "cli.ts" as cli {
    check : schema + cross checks
    links : test current URLs
    parliament : fetch ws.parl.ch
    cantonal-parliaments : fetch OFS
  }
  class "cantonal-parliaments.ts" as tcparl {
    +extractTable()
    +checkCantonalParliaments()
    column mapping, sizes
  }
  class "xlsx.ts" as xlsx {
    +readWorkbook()
    Node built-ins only
  }
  class "cantonal-governments.ts\nparty-presidencies.ts" as handkept {
    +checkCantonalGovernments()
    +checkPresidencies()
    +isStale() : 180 days
  }
  class "build.ts" as build {
    esbuild IIFE bundle
    copies index.html, css, LICENSE
  }
}

class "data/*.json" as data <<referential>> {
  territories, parties, state-sites
  tools, ballot, parliament-current
  cantonal-parliaments, cantonal-governments
}

main --> app
main --> ballot
main --> inst
ballot --> app : scope(), onRender()
inst --> app : scope(), onRender()
app --> ref
ballot --> ref
inst --> ref
app --> parl
inst --> parl
app --> standing
app --> pres
inst --> cparl
standing --> cparl
inst --> colours
app --> links
ballot --> links
inst --> links
ref --> types : types only
parl --> types : types only
ref ..> data : imported at build time
cli --> types : schemas
cli --> links : ids the site needs
cli --> parl : same reading as the site
cli --> tcparl
cli --> handkept
tcparl --> cparl : same reading as the site
cli --> xlsx
handkept --> pres : names
cli ..> data : reads, writes the generated files
build ..> main : bundles

@enduml
