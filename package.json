{
  "name": "civic-compass",
  "version": "0.0.0",
  "private": true,
  "description": "La prochaine votation, les partis de gauche à droite, les outils d'aide au vote et les sites officiels, en Suisse et dans les cantons.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "check": "tsc -p tsconfig.json && tsc -p tools/tsconfig.json && node tools/cli.ts check",
    "links": "node tools/cli.ts links",
    "parliament": "node tools/cli.ts parliament",
    "cantonal-parliaments": "node tools/cli.ts cantonal-parliaments",
    "media-register": "node tools/cli.ts media-register",
    "campaign-financing": "node tools/cli.ts campaign-financing",
    "test": "node --test tools/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "cytoscape": "3.35.0",
    "cytoscape-fcose": "2.2.0"
  }
}
